# Remote Admin Enterprises — Environment Configuration
# Copy to .env and set real values before running:
#   cp .env.example .env

# PostgreSQL
POSTGRES_DB=remote_admin
POSTGRES_USER=remote_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_PORT=5432

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000

# JWT — MUST be changed for production (minimum 64 characters)
JWT_KEY=CHANGE-THIS-TO-A-LONG-RANDOM-SECRET-KEY-AT-LEAST-64-CHARACTERS-LONG-FOR-PRODUCTION
JWT_ISSUER=RemoteAdminEnterprises
JWT_AUDIENCE=RemoteAdminEnterprises
JWT_EXPIRY_MINUTES=480

# Connection String
CONNECTION_STRING=Host=localhost;Port=5432;Database=remote_admin;Username=remote_admin;Password=CHANGE_ME_TO_STRONG_PASSWORD

# Package Storage
PACKAGE_STORAGE_PATH=./packages

# CORS (comma-separated origins)
CORS_ORIGINS=https://remote-admin.local

# Logging
LOG_LEVEL=Information
