{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=remote_admin;Username=remote_admin;Password=dev_password_change_me"
  },
  "Jwt": {
    "Key": "CHANGE-THIS-TO-A-LONG-RANDOM-SECRET-KEY-AT-LEAST-64-CHARACTERS-LONG-FOR-PRODUCTION",
    "Issuer": "RemoteAdminEnterprises",
    "Audience": "RemoteAdminEnterprises",
    "ExpiryMinutes": 480
  },
  "Cors": {
    "Origins": ["http://localhost:3000"]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "PackageStorage": {
    "BasePath": "./packages"
  },
  "Agent": {
    "HeartbeatIntervalSeconds": 60,
    "HeartbeatTimeoutMultiplier": 3,
    "InventoryIntervalMinutes": 60,
    "EnrollmentTokenExpiry": "24:00:00"
  },
  "Deployment": {
    "DefaultWaveSize": 25,
    "MaxRetries": 3,
    "DefaultTimeoutSeconds": 3600,
    "OfflineWaitHours": 72
  }
}
